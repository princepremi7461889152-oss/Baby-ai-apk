rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && !id.matches('.*[/\\.].*');
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['email', 'plan', 'tasksRemaining', 'createdAt']) &&
             data.keys().hasOnly([
               'email',
               'plan',
               'tasksRemaining',
               'createdAt',
               'memories',
               'taskHistory',
               'conversationHistory',
               'messageHistory'
             ]) &&
             data.email is string && data.email.size() <= 254 &&
             data.plan in ['free', 'pro'] &&
             data.tasksRemaining is int && data.tasksRemaining >= 0 && data.tasksRemaining <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('memories' in data) || (data.memories is list && data.memories.size() <= 500)) &&
             (!('taskHistory' in data) || (data.taskHistory is list && data.taskHistory.size() <= 500)) &&
             (!('conversationHistory' in data) || (data.conversationHistory is list && data.conversationHistory.size() <= 500)) &&
             (!('messageHistory' in data) || (data.messageHistory is list && data.messageHistory.size() <= 1000));
    }

    function isValidUserUpdate(newData, oldData) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'email',
               'plan',
               'tasksRemaining',
               'memories',
               'taskHistory',
               'conversationHistory',
               'messageHistory'
             ]) &&
             newData.createdAt == oldData.createdAt &&
             newData.email is string && newData.email.size() <= 254 &&
             newData.plan in ['free', 'pro'] &&
             (!('tasksRemaining' in newData) || (newData.tasksRemaining is int && newData.tasksRemaining >= -10 && newData.tasksRemaining <= 1000)) &&
             (!('memories' in newData) || (newData.memories is list && newData.memories.size() <= 500)) &&
             (!('taskHistory' in newData) || (newData.taskHistory is list && newData.taskHistory.size() <= 500)) &&
             (!('conversationHistory' in newData) || (newData.conversationHistory is list && newData.conversationHistory.size() <= 500)) &&
             (!('messageHistory' in newData) || (newData.messageHistory is list && newData.messageHistory.size() <= 1000));
    }

    function isValidGeminiLog(data, userId) {
      return data.keys().hasAll(['userId', 'timestamp', 'status', 'attempt', 'model', 'prompt', 'imagesCount', 'responseTimeMs']) &&
             data.keys().hasOnly(['userId', 'timestamp', 'status', 'attempt', 'model', 'prompt', 'imagesCount', 'responseTimeMs', 'llmReply', 'error']) &&
             data.userId == userId &&
             data.timestamp is timestamp && data.timestamp <= request.time &&
             data.status in ['pass', 'error'] &&
             data.attempt is int && data.attempt >= 1 && data.attempt <= 20 &&
             data.model is string && data.model.size() >= 1 && data.model.size() <= 100 &&
             data.prompt is string && data.prompt.size() <= 4000 &&
             data.imagesCount is int && data.imagesCount >= 0 && data.imagesCount <= 50 &&
             data.responseTimeMs is int && data.responseTimeMs >= 0 &&
             (!('llmReply' in data) || data.llmReply == null || (data.llmReply is string && data.llmReply.size() <= 8000)) &&
             (!('error' in data) || data.error == null || (data.error is string && data.error.size() <= 2000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserCreate(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserUpdate(request.resource.data, resource.data);
      allow delete: if false;

      match /gemini_logs/{logId} {
        allow read: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(logId) && isValidGeminiLog(request.resource.data, userId);
        allow update, delete: if false;
      }
    }

    match /settings/{settingId} {
      allow get: if isAuthenticated() && isValidId(settingId);
      allow list, write: if false;
    }
  }
}
