<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_solid"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".publicapis.PublicApisActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBackPublicApis"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oxanium"
                android:text="Public APIs"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPublicApisCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading catalog..."
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSyncPublicApis"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/btn_with_border"
            android:fontFamily="@font/oxanium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Sync GitHub"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/editSearchPublicApis"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_border"
        android:fontFamily="@font/oxanium"
        android:hint="Search APIs, descriptions, or categories"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#CECECE"
        android:textColorHint="#888888"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPickCategory"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_with_border"
            android:ellipsize="end"
            android:fontFamily="@font/oxanium"
            android:maxLines="1"
            android:text="Category: All"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnToggleNoAuth"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_with_border"
            android:fontFamily="@font/oxanium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="No Auth"
            android:textAllCaps="false"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnToggleHttps"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/btn_with_border"
            android:fontFamily="@font/oxanium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="HTTPS"
            android:textAllCaps="false"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressPublicApis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPublicApis"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvEmptyPublicApis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="No matching APIs found."
        android:textColor="#888888"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
