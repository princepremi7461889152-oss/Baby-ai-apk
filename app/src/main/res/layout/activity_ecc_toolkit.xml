<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_solid"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="14dp"
    tools:context=".ecc.EccToolkitActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBackEcc"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oxanium"
                android:text="ECC Toolkit"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEccSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="affaan-m/ECC • Gemini 3.8 Flash"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSyncEcc"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/btn_with_border"
            android:fontFamily="@font/oxanium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Sync ECC"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Primary 5-Section Navigation Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabEccWorkflow"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_with_border"
                android:fontFamily="@font/oxanium"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Workflow"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabEccAgents"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_with_border"
                android:fontFamily="@font/oxanium"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Agents &amp; Skills"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabEccReview"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_with_border"
                android:fontFamily="@font/oxanium"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Review &amp; Scan"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabEccRulesMemory"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_with_border"
                android:fontFamily="@font/oxanium"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Rules &amp; Context"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabEccResearch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/btn_with_border"
                android:fontFamily="@font/oxanium"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Research"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progressEcc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <!-- SECTION 1: 5-Stage AI Coding Workflow -->
    <ScrollView
        android:id="@+id/panelEccWorkflow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display"
                android:text="Plan → Test → Implement → Review → Verify"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWorkflowStageInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Stage 1/5: Plan — Scope requirements, architecture, impacted modules, and edge cases."
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnStagePlan"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_with_border"
                        android:text="1. Plan"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnStageTest"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_with_border"
                        android:text="2. Test"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnStageImplement"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_with_border"
                        android:text="3. Implement"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnStageReview"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/btn_with_border"
                        android:text="4. Review"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnStageVerify"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_with_border"
                        android:text="5. Verify"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <EditText
                android:id="@+id/editWorkflowGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_text_border"
                android:gravity="top|start"
                android:hint="Describe the feature, refactor, or bug to engineer with ECC..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="#CECECE"
                android:textColorHint="#888888"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnRunWorkflowStage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/rounded_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Run Current Stage"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnNextWorkflowStage"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_with_border"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Next Stage"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_background"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWorkflowOutputHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/oxanium"
                        android:text="Stage Output"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSaveWorkflowLearn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_with_border"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Save /learn"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWorkflowOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Enter a task above and tap Run Current Stage. Outputs flow automatically into Test -> Implement -> Review -> Verify."
                    android:textColor="#CECECE"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- SECTION 2: Agents, Skills & Slash Commands -->
    <LinearLayout
        android:id="@+id/panelEccAgents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/editSearchEccComponents"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_border"
            android:hint="Search ECC agents, skills, or /commands..."
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#CECECE"
            android:textColorHint="#888888"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterEccAll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_with_border"
                android:text="All"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterEccAgents"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_with_border"
                android:text="Agents"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterEccSkills"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_with_border"
                android:text="Skills"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterEccCommands"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/btn_with_border"
                android:text="/Cmds"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerEccComponents"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />
    </LinearLayout>

    <!-- SECTION 3: Automated Code Review, Debugging & AgentShield Security Scan -->
    <ScrollView
        android:id="@+id/panelEccReview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/playfair_display"
                    android:text="AgentShield Scanner &amp; Debugger"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnLoadSampleCode"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_with_border"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Load Sample"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/editCodeReviewInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_border"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="Paste Kotlin/Java/JS code, Gradle error, or stack trace..."
                android:inputType="textMultiLine"
                android:minLines="5"
                android:padding="12dp"
                android:textColor="#CECECE"
                android:textColorHint="#888888"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnRunSecurityScan"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/rounded_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Security Scan"
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRunAiCodeReview"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_with_border"
                    android:text="AI Review"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRunDebugError"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_with_border"
                    android:text="Debug Error"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_background"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvScanSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/oxanium"
                    android:text="Ready to scan code offline or run Gemini 3.8 Flash review/debugging."
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Security findings, severity score (0-100), and recommended fixes appear here."
                    android:textColor="#CECECE"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- SECTION 4: Project Rules, Context Modes & Persistent Engineering Memory -->
    <ScrollView
        android:id="@+id/panelEccRulesMemory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display"
                android:text="Active Context Mode"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnContextDev"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_with_border"
                    android:text="Dev"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnContextReview"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_with_border"
                    android:text="Review"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnContextResearch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_with_border"
                    android:text="Research"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/playfair_display"
                    android:text="ECC Project Rules"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAddCustomRule"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_with_border"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="+ Rule"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerEccRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/playfair_display"
                    android:text="Persistent Project Memory (/learn)"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAddEccMemory"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_with_border"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="+ Instinct"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerEccMemories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvContextBudgetInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/oxanium"
                android:text="Strategic Context Brief: 0 / 2400 chars"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- SECTION 5: Research-First Lookup & Documentation -->
    <ScrollView
        android:id="@+id/panelEccResearch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display"
                android:text="Research-First Docs Lookup"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Verify SDK APIs, dependencies, Play policy constraints, and matching Public APIs before coding."
                android:textColor="#888888"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editResearchTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_text_border"
                android:gravity="top|start"
                android:hint="e.g. WorkManager periodic sync, Weather APIs, CredentialManager..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="#CECECE"
                android:textColorHint="#888888"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnRunResearchLookup"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/rounded_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Run Research Brief"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOpenPublicApisFromEcc"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_with_border"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Public APIs"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_background"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvResearchOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter a library, Android API, or domain topic to generate an ECC Research-First brief."
                    android:textColor="#CECECE"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
